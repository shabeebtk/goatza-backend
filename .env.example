# Copy to .env and fill in. Never commit the filled-in file.

DJANGO_SECRET_KEY=
JWT_SECRET_KEY=
DEBUG=True

# ── database ──
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DB_SSL_MODE=

# ── media storage provider ──
# "r2" (default) or "cloudinary" (rollback, removed in the cleanup stage).
FILE_STORAGE_PROVIDER=r2

# ── Cloudflare R2 (media) ──
# Account id is the subdomain of the S3 endpoint:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=goatza-media

# Public delivery origin, NO trailing slash. Production is the CDN domain in
# front of the bucket; for local dev use the bucket's r2.dev URL.
MEDIA_PUBLIC_BASE_URL=https://media.goatza.com

# ── Cloudinary (media — legacy, still live behind FILE_STORAGE_PROVIDER) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Eager HLS ladder for videos. Costs real transformation credits — leave off.
CLOUDINARY_ENABLE_HLS=False

# ── google login ──
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_SCOPE=
GOOGLE_CALLBACK_URI=

# ── email ──
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── firebase (push) ──
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# ── redis (channels) ──
REDIS_URL=
REDIS_SSL=
