# Media storage — Cloudflare R2 (GOATZA_R2_MIGRATION.md §5.4 / §9)
#
# Copy the R2 values out of the Cloudflare dashboard:
#   R2 → Overview                     → Account ID
#   R2 → Manage API tokens → Create   → "Object Read & Write", scoped to the
#                                        goatza-media bucket ONLY (no admin
#                                        scopes) → Access Key ID + Secret
#   R2 → goatza-media → Settings → Custom Domains → media.goatza.com
#                                        (leave the public r2.dev URL disabled)

# "r2" is the provider. "cloudinary" is a temporary rollback switch that Stage 6
# deletes — do not ship anything new against it.
FILE_STORAGE_PROVIDER=r2

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=goatza-media

# Public delivery base. Stored URLs are this + "/" + key, and every
# client-submitted media URL must start with it — it is a security boundary,
# so it must be the custom domain, never the r2.cloudflarestorage.com endpoint.
MEDIA_PUBLIC_BASE_URL=https://media.goatza.com
