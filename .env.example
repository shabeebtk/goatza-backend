# Copy to .env and fill in. Never commit the filled-in file.

DJANGO_SECRET_KEY=
JWT_SECRET_KEY=
DEBUG=True

# ── database ──
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DB_SSL_MODE=

# ── media storage provider ──
# "r2" (default) or "cloudinary" (rollback, removed in the cleanup stage).
FILE_STORAGE_PROVIDER=r2

# ── Cloudflare R2 (media) ──
# Account id is the subdomain of the S3 endpoint:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=goatza-media

# Public delivery origin, NO trailing slash. Production is the CDN domain in
# front of the bucket; for local dev use the bucket's r2.dev URL.
MEDIA_PUBLIC_BASE_URL=https://media.goatza.com

# ── Cloudinary (media — legacy, still live behind FILE_STORAGE_PROVIDER) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Eager HLS ladder for videos. Costs real transformation credits — leave off.
CLOUDINARY_ENABLE_HLS=False

# ── google login ──
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_SCOPE=
GOOGLE_CALLBACK_URI=

# ── email ──
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── firebase (push) ──
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# ── redis (channels) ──
REDIS_URL=
REDIS_SSL=

# ── google places (city + venue search) ──
# Server-side ONLY — this key must never reach the browser. Restrict it in the
# Google console to "Places API (New)" and nothing else.
# Leave blank and the app still boots; /places/* answers 503.
GOOGLE_PLACES_API_KEY=

# Our own daily spend guard, per UTC day. Google console quotas are the outer
# backstop; these return a friendly 503 before the call is made. Place Details
# and the coordinate-refresh job share the details cap — same SKU.
PLACES_DAILY_CAP_AUTOCOMPLETE=2000
PLACES_DAILY_CAP_DETAILS=1000

# City-picker type filter, comma-separated. "(cities)" = locality +
# administrative_area_level_3. If village-level places go missing, widen to
# e.g. locality,sublocality,neighborhood,administrative_area_level_3,administrative_area_level_4
# (max 5 values; a collection like "(cities)" cannot be mixed with individual
# types).
PLACES_CITY_PRIMARY_TYPES=(cities)

# Coordinate lifecycle, in days (manage.py refresh_place_coords). Coordinates
# are a cache, not a stored fact: refresh a place something still uses, expire
# (null) one nothing does. Refresh below expire, so a place has several runs to
# be caught before it is dropped. ACTIVE_USER_DAYS is the window that decides
# whether a profile still keeps its city alive.
PLACES_COORDS_REFRESH_AFTER_DAYS=25
PLACES_COORDS_EXPIRE_AFTER_DAYS=30
PLACES_ACTIVE_USER_DAYS=30
